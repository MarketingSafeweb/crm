# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — never commit real secrets; only the template is tracked
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Evidências brutas — BARREIRA DE SEGURANÇA
# Nada dentro de _evidencias-brutas/ é versionado, exceto o README.
# Dados pessoais, exportações, dumps, planilhas e segredos NUNCA vão para o Git.
/_evidencias-brutas/*
!/_evidencias-brutas/README.md
# Formatos de dado bruto barrados em qualquer lugar do repositório
*.dump
*.sql.gz
*.bak
*.xlsx
*.parquet
